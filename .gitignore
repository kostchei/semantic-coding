# Binary tools directory - only track the wrapper script
bin/*
!bin/grepai-hybrid.cmd
*.exe

# grepai metadata directories (may contain local config tokens)
.grepai/
**/.grepai/

# Upstream testbed repository (cloned dynamically during setup/run)
grepai/

# Test workspaces with local configs (may contain local tokens) and large gob indices
repo-text/
repo-code/
workspaces/
*.gob

# Python cache & virtual environments
__pycache__/
*.pyc
.venv/
venv/

# Environment files and credentials
.env
*token*
*secret*

# Training checkpoints and weights
training/checkpoints/
*.pt

# Telemetry raw logs
telemetry/interactions.jsonl
harness-results/

# OS artifacts
Thumbs.db
.DS_Store
