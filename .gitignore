# Python cache & virtual environments
__pycache__/
*.pyc
.venv/
venv/

# Environment files and credentials
.env
.env.*
*token*
*secret*

# Benchmark outputs and backups
benchmark_results.json
benchmarks/*results*.json
*.bak

# Training checkpoints and telemetry
training/checkpoints/
*.pt
telemetry/interactions.jsonl
telemetry/triplets.jsonl
harness-results/

# OS artifacts
Thumbs.db
.DS_Store
